; Engine configuration file.
; Generated for Веселый Могильщик (Cheerful Gravedigger).

config_version=5

[application]

config/name="Весёлый Могильщик"
config/description="3D top-down cemetery time-management sim"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

TimeManager="*res://scripts/autoload/time_manager.gd"
Economy="*res://scripts/autoload/economy.gd"
OrderManager="*res://scripts/autoload/order_manager.gd"
NameGenerator="*res://scripts/autoload/name_generator.gd"
ProcGen="*res://scripts/autoload/procgen.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

